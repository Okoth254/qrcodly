# Copy to .env.docker and set real values. Never commit .env.docker.
COMPOSE_PROJECT_NAME=qrcodly
MYSQL_DATABASE=qrcodly
MYSQL_USER=qrcodly
MYSQL_PASSWORD=REPLACE_WITH_LONG_RANDOM_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_LONG_RANDOM_ROOT_PASSWORD
MINIO_ROOT_USER=REPLACE_WITH_MINIO_ADMIN_USERNAME
MINIO_ROOT_PASSWORD=REPLACE_WITH_LONG_RANDOM_MINIO_PASSWORD
INTERNAL_API_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
BACKEND_BIND=127.0.0.1
BACKEND_PORT=5001
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=3000
NEXT_PUBLIC_FRONTEND_URL=https://your-domain.example
NEXT_PUBLIC_API_URL=https://api.your-domain.example/api/v1
BACKEND_URL=https://api.your-domain.example
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID_MONTHLY=price_replace_me
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID_ANNUAL=price_replace_me
NEXT_PUBLIC_STRIPE_ADDON_DOMAIN_PRICE_ID_MONTHLY=price_replace_me
NEXT_PUBLIC_STRIPE_ADDON_DOMAIN_PRICE_ID_ANNUAL=price_replace_me
NEXT_PUBLIC_GOOGLE_API_KEY=replace_me
AXIOM_TOKEN=
AXIOM_DATASET=
NEXT_PUBLIC_CLERK_JS_URL=/__clerk-js/dist/clerk.browser.min.js
NEXT_PUBLIC_SENTRY_DSN=https://YOUR_PUBLIC_KEY@o0.ingest.sentry.io/0
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
CLERK_SECRET_KEY=sk_test_replace_me
